{
  "name": "thistogram",
  "version": "2.0.0",
  "description": "A simple text based histogram and chart generator",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf coverage dist",
    "lint": "pnpm eslint && pnpm prettier",
    "lint:fix": "pnpm eslint:fix && pnpm prettier:fix",
    "prettier": "prettier -c .",
    "prettier:fix": "prettier -w .",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "spell": "cspell --no-progress .",
    "run:samples": "cd samples && pnpm add .. && pnpm run:samples",
    "update-readme": "pnpm run:samples && inject-markdown README.md"
  },
  "keywords": [
    "histogram",
    "Unicode"
  ],
  "author": "Street Side Software",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tsconfig/node20": "^20.1.8",
    "@vitest/coverage-istanbul": "^3.2.4",
    "cspell": "^9.3.2",
    "eslint": "^9.39.1",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "inject-markdown": "^4.0.0",
    "prettier": "^3.7.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!**/*.test.*",
    "!**/*.map.*"
  ],
  "engines": {
    "node": ">=20.18.0"
  }
}
