{
  "name": "thistogram",
  "version": "2.0.0",
  "description": "A simple text based histogram and chart generator",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf coverage dist",
    "lint": "pnpm eslint && pnpm prettier",
    "lint:fix": "pnpm eslint:fix && pnpm prettier:fix",
    "prettier": "prettier -c .",
    "prettier:fix": "prettier -w .",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "spell": "cspell --no-progress .",
    "run:samples": "pnpm -r run:samples",
    "update-readme": "pnpm run:samples && inject-markdown README.md"
  },
  "keywords": [
    "histogram",
    "Unicode"
  ],
  "author": "Street Side Software",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streetsidesoftware/thistogram.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-istanbul": "^5.1.0",
    "cspell": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "inject-markdown": "^6.3.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!**/*.test.*",
    "!**/*.map.*"
  ],
  "engines": {
    "node": ">=22.18.0"
  }
}
